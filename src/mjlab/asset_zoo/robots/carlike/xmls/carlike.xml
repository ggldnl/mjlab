<mujoco model="carlike">
  <option timestep="0.005" integrator="implicitfast"/>

  <default>
    <!-- Rolling road wheel: spins about its local y axis. -->
    <default class="wheel">
      <joint type="hinge" axis="0 1 0" damping="0.001"/>
      <geom type="cylinder" size="0.05 0.02" material="wheel"
            friction="1.5 0.02 0.001" mass="0.2"/>
    </default>
    <!-- Steering knuckle: rotates the front wheel about the vertical axis. -->
    <default class="steer">
      <joint type="hinge" axis="0 0 1" limited="true" range="-0.6 0.6" damping="0.1"/>
    </default>
  </default>

  <asset>
    <material name="chassis" rgba=".2 .3 .7 1"/>
    <material name="wheel" rgba=".15 .15 .15 1"/>
    <material name="heading" rgba=".1 .6 .8 1"/>
  </asset>

  <worldbody>
    <light name="light" pos="0 0 4" dir="0 0 -1"/>
    <geom name="floor" pos="0 0 0" size="0 0 .05" type="plane"
          friction="1.0 0.005 0.0001"/>

    <!-- The base frame sits at wheel-axle height so the wheels rest on the floor.
         The chassis box and a heavy hidden ballast are raised well above the axle
         to put the centre of mass high: with the narrow track that is what lets a
         hard steer at speed roll the car rather than merely scrub. -->
    <body name="base" pos="0 0 0.05">
      <freejoint name="root"/>
      <geom name="chassis" type="box" pos="0 0 0.07" size="0.15 0.06 0.05"
            material="chassis" mass="2.0"/>
      <!-- Heading marker so forward (+x) is visible. -->
      <geom name="nose" type="box" pos="0.17 0 0.07" size="0.02 0.02 0.02"
            material="heading" mass="0.001"/>
      <!-- Heavy, invisible ballast high in the chassis: raises the centre of mass
           without showing or colliding (contype/conaffinity 0, fully transparent). -->
      <geom name="ballast" type="sphere" pos="0 0 0.14" size="0.03" mass="3.0"
            contype="0" conaffinity="0" rgba="0 0 0 0"/>

      <!-- Front axle: each wheel hangs off a steering knuckle (driven by the
           steering actuators); the wheels themselves roll passively. -->
      <body name="front_left_steer" pos="0.12 0.08 0">
        <inertial pos="0 0 0" mass="0.05" diaginertia="1e-4 1e-4 1e-4"/>
        <joint name="front_left_steer" class="steer"/>
        <body name="front_left_wheel" pos="0 0 0">
          <joint name="front_left_wheel" class="wheel"/>
          <geom name="front_left_wheel" class="wheel" euler="90 0 0"/>
        </body>
      </body>
      <body name="front_right_steer" pos="0.12 -0.08 0">
        <inertial pos="0 0 0" mass="0.05" diaginertia="1e-4 1e-4 1e-4"/>
        <joint name="front_right_steer" class="steer"/>
        <body name="front_right_wheel" pos="0 0 0">
          <joint name="front_right_wheel" class="wheel"/>
          <geom name="front_right_wheel" class="wheel" euler="90 0 0"/>
        </body>
      </body>

      <!-- Rear axle: driven wheels, fixed straight ahead. -->
      <body name="rear_left_wheel" pos="-0.12 0.08 0">
        <joint name="rear_left_wheel" class="wheel"/>
        <geom name="rear_left_wheel" class="wheel" euler="90 0 0"/>
      </body>
      <body name="rear_right_wheel" pos="-0.12 -0.08 0">
        <joint name="rear_right_wheel" class="wheel"/>
        <geom name="rear_right_wheel" class="wheel" euler="90 0 0"/>
      </body>
    </body>
  </worldbody>

  <!-- Standalone actuators (position servos on the steering, torque motors on the
       rear wheels). mjlab strips these in get_spec and adds its own PD actuators;
       they are kept for direct use of the .xml. -->
  <actuator>
    <position name="front_left_steer" joint="front_left_steer" kp="10"
              ctrllimited="true" ctrlrange="-0.6 0.6"/>
    <position name="front_right_steer" joint="front_right_steer" kp="10"
              ctrllimited="true" ctrlrange="-0.6 0.6"/>
    <motor name="rear_left_wheel" joint="rear_left_wheel" gear="1"
           ctrllimited="true" ctrlrange="-2 2"/>
    <motor name="rear_right_wheel" joint="rear_right_wheel" gear="1"
           ctrllimited="true" ctrlrange="-2 2"/>
  </actuator>
</mujoco>
