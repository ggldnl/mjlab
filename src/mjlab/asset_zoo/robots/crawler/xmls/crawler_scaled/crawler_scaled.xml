<mujoco model="crawler">

    <compiler angle="radian" autolimits="true"/>

    <default>

        <!--
            Visual meshes: no physics contribution whatsoever.
            density=0  -> no mass / inertia contribution
            contype=0 conaffinity=0 -> invisible to the collision pipeline
            group=2    -> viewer group toggled separately from collision shapes
        -->
        <default class="visual">
            <geom type="mesh" density="0" contype="0" conaffinity="0" group="2"/>
        </default>

        <!--
            Collision primitives: participate in contact detection.
            contype=1 conaffinity=1 -> standard colliding pair (fixed from original)
            density=0  -> inertia comes from the explicit <inertial> tags, not geoms
            group=3    -> invisible in the viewer by default (groups 0-2 are shown);
                          toggle on with Ctrl+G (or 'g' key) during inspection
        -->
        <default class="collision">
            <geom density="0" contype="1" conaffinity="1" group="3"
                  rgba="0.4 0.8 0.4 0.4"/>
        </default>
    </default>

    <asset>
        <mesh name="base"  file="assets/base.stl"  scale="0.001 0.001 0.001"/>
        <mesh name="coxa"  file="assets/coxa.stl"  scale="0.001 0.001 0.001"/>
        <mesh name="femur" file="assets/femur.stl" scale="0.001 0.001 0.001"/>
