    <compiler angle="radian" autolimits="true" />

    <default>

        <joint damping="0.0165" frictionloss="0.0005" solreflimit="0.04 1" solimplimit="0.9 0.95 0.005 0.5 2"/>

        <!--
            Visual meshes: no physics contribution whatsoever.
            density=0 -> no mass/inertia (inertial tag is used instead)
            contype=0 conaffinity=0 -> invisible to the collision pipeline
            group=2 -> viewer group toggled separately from collision shapes
        -->
        <default class="visual">
            <geom type="mesh" density="0" contype="0" conaffinity="0" group="2"/>
        </default>

        <!--
            Generic collision default (fallback, not used directly).
        -->
        <default class="collision">
            <geom contype="0" conaffinity="0" group="3"/>
        </default>

        <!--
            Leg-segment collision capsules / spheres.
            All start with contype=0 conaffinity=0 so they are dormant at
            load time. CollisionCfg is the single source of truth for which
            geoms are active and with what parameters.
            density=0 -> mass comes from the body's explicit <inertial> tag.
            group=3 -> viewer group toggled separately from visual meshes.
        -->
        <default class="coxa_collision">
            <geom type="capsule" size="0.004" density="0" contype="0" conaffinity="0" group="3"/>
        </default>
        <default class="femur_collision">
            <geom type="capsule" size="0.004" density="0" contype="0" conaffinity="0" group="3"/>
        </default>
        <default class="tibia_collision">
            <geom type="capsule" size="0.004" density="0" contype="0" conaffinity="0" group="3"/>
        </default>
        <default class="foot_collision">
            <geom type="sphere" size="0.004" density="0" contype="0" conaffinity="0" group="3" friction="0.6 0.005 0.0001"/>
        </default>
    </default>

